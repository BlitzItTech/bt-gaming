{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",          // Change to "app.main:app" if main.py is inside an 'app' folder
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "jinja": true
    }
  ]
}